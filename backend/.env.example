# === APP CONFIG ===
ENVIRONMENT=development
# Any SQLAlchemy URL works here without code changes, e.g.:
#   SQLite file (default): sqlite:///./reviews.db
#   SQLite memory (tests): sqlite:///:memory:
#   Postgres (later):      postgresql+psycopg://user:pass@localhost:5432/reviews
DATABASE_URL=sqlite:///./reviews.db

# === LLM CONFIG ===
# Options: mock | groq | ollama
LLM_PROVIDER=mock
LLM_TIMEOUT=20.0

# === GROQ API (cloud provider) ===
# Get a key at https://console.groq.com — never commit the real key.
GROQ_API_KEY=gsk_your_real_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# === OLLAMA (local provider) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
